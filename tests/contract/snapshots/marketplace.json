{
  "create_proposal_draft": {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true,
      "readOnlyHint": false
    },
    "description": "Save a proposal as a marketplace draft. Spends no Connects. With dry_run, only\n    preview the payload and the Connects that submitting it would cost.",
    "inputSchema": {
      "properties": {
        "bid_amount": {
          "exclusiveMinimum": 0,
          "maximum": 1000000,
          "title": "Bid Amount",
          "type": "number"
        },
        "cover_letter": {
          "maxLength": 5000,
          "minLength": 1,
          "title": "Cover Letter",
          "type": "string"
        },
        "dry_run": {
          "default": false,
          "title": "Dry Run",
          "type": "boolean"
        },
        "idempotency_key": {
          "description": "Unique key for this intended write. Reuse the same key when retrying it.",
          "maxLength": 128,
          "minLength": 8,
          "title": "Idempotency Key",
          "type": "string"
        },
        "job_id": {
          "pattern": "^[\\w-]{1,64}$",
          "title": "Job Id",
          "type": "string"
        },
        "screening_answers": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 10,
          "title": "Screening Answers",
          "type": "array"
        }
      },
      "required": [
        "job_id",
        "cover_letter",
        "bid_amount",
        "idempotency_key"
      ],
      "title": "create_proposal_draftArguments",
      "type": "object"
    },
    "name": "create_proposal_draft",
    "outputSchema": {
      "$defs": {
        "Proposal": {
          "properties": {
            "bid_amount": {
              "exclusiveMinimum": 0,
              "maximum": 1000000,
              "title": "Bid Amount",
              "type": "number"
            },
            "connects_cost": {
              "title": "Connects Cost",
              "type": "integer"
            },
            "cover_letter": {
              "maxLength": 5000,
              "minLength": 1,
              "title": "Cover Letter",
              "type": "string"
            },
            "created_at": {
              "format": "date-time",
              "title": "Created At",
              "type": "string"
            },
            "id": {
              "title": "Id",
              "type": "string"
            },
            "job_id": {
              "title": "Job Id",
              "type": "string"
            },
            "screening_answers": {
              "default": [],
              "items": {
                "type": "string"
              },
              "maxItems": 10,
              "title": "Screening Answers",
              "type": "array"
            },
            "status": {
              "enum": [
                "draft",
                "submitted"
              ],
              "title": "Status",
              "type": "string"
            },
            "submitted_at": {
              "anyOf": [
                {
                  "format": "date-time",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Submitted At"
            }
          },
          "required": [
            "job_id",
            "cover_letter",
            "bid_amount",
            "id",
            "status",
            "connects_cost",
            "created_at",
            "submitted_at"
          ],
          "title": "Proposal",
          "type": "object"
        },
        "ProposalIn": {
          "properties": {
            "bid_amount": {
              "exclusiveMinimum": 0,
              "maximum": 1000000,
              "title": "Bid Amount",
              "type": "number"
            },
            "cover_letter": {
              "maxLength": 5000,
              "minLength": 1,
              "title": "Cover Letter",
              "type": "string"
            },
            "job_id": {
              "title": "Job Id",
              "type": "string"
            },
            "screening_answers": {
              "default": [],
              "items": {
                "type": "string"
              },
              "maxItems": 10,
              "title": "Screening Answers",
              "type": "array"
            }
          },
          "required": [
            "job_id",
            "cover_letter",
            "bid_amount"
          ],
          "title": "ProposalIn",
          "type": "object"
        }
      },
      "properties": {
        "connects_balance": {
          "title": "Connects Balance",
          "type": "integer"
        },
        "connects_cost": {
          "description": "Connects charged when the draft is submitted",
          "title": "Connects Cost",
          "type": "integer"
        },
        "dry_run": {
          "title": "Dry Run",
          "type": "boolean"
        },
        "payload": {
          "$ref": "#/$defs/ProposalIn"
        },
        "proposal": {
          "anyOf": [
            {
              "$ref": "#/$defs/Proposal"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "dry_run",
        "payload",
        "connects_cost",
        "connects_balance"
      ],
      "title": "DraftResult",
      "type": "object"
    }
  },
  "get_client_history": {
