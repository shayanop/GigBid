{
  "prompts": {},
  "resource_templates": {},
  "tools": {
    "create_email_draft": {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "description": "Save an email draft for the freelancer to review and send themselves.",
      "inputSchema": {
        "properties": {
          "body": {
            "maxLength": 10000,
            "minLength": 1,
            "title": "Body",
            "type": "string"
          },
          "idempotency_key": {
            "description": "Unique key for this intended write. Reuse the same key when retrying it.",
            "maxLength": 128,
            "minLength": 8,
            "title": "Idempotency Key",
            "type": "string"
          },
          "subject": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Subject",
            "type": "string"
          },
          "to": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "To"
          }
        },
        "required": [
          "subject",
          "body",
          "idempotency_key"
        ],
        "title": "create_email_draftArguments",
        "type": "object"
      },
      "name": "create_email_draft",
      "outputSchema": {
        "properties": {
          "body": {
            "title": "Body",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "subject": {
            "title": "Subject",
            "type": "string"
          },
          "to": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "To"
          }
        },
        "required": [
          "id",
          "to",
          "subject",
          "body",
          "created_at"
        ],
        "title": "EmailDraft",
        "type": "object"
      }
    },
    "find_free_slots": {
      "annotations": {
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "description": "Free weekday slots (UTC), at most one per day so the client gets real options.",
      "inputSchema": {
        "properties": {
          "days_ahead": {
            "default": 7,
            "maximum": 21,
            "minimum": 1,
            "title": "Days Ahead",
            "type": "integer"
          },
          "duration_minutes": {
            "default": 30,
            "maximum": 240,
            "minimum": 15,
            "title": "Duration Minutes",
            "type": "integer"
          },
          "earliest_hour": {
            "default": 9,
            "maximum": 23,
            "minimum": 0,
            "title": "Earliest Hour",
            "type": "integer"
          },
          "latest_hour": {
            "default": 17,
            "maximum": 24,
            "minimum": 1,
            "title": "Latest Hour",
            "type": "integer"
          },
          "limit": {
            "default": 3,
            "maximum": 10,
            "minimum": 1,
            "title": "Limit",
            "type": "integer"
          }
        },
        "title": "find_free_slotsArguments",
        "type": "object"
      },
      "name": "find_free_slots",
      "outputSchema": {
        "$defs": {
          "Slot": {
            "properties": {
              "end": {
                "format": "date-time",
                "title": "End",
                "type": "string"
              },
              "start": {
                "format": "date-time",
                "title": "Start",
                "type": "string"
              }
            },
            "required": [
              "start",
              "end"
            ],
            "title": "Slot",
            "type": "object"
          }
        },
        "properties": {
          "result": {
            "items": {
              "$ref": "#/$defs/Slot"
            },
            "title": "Result",
            "type": "array"
          }
        },
        "required": [
          "result"
        ],
        "title": "find_free_slotsOutput",
        "type": "object"
      }
    },
    "hold_slot": {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "description": "Put a tentative hold on the calendar, e.g. an interview time offered to a client.",
      "inputSchema": {
        "properties": {
          "end": {
            "format": "date-time",
            "title": "End",
            "type": "string"
          },
          "idempotency_key": {
            "description": "Unique key for this intended write. Reuse the same key when retrying it.",
            "maxLength": 128,
            "minLength": 8,
            "title": "Idempotency Key",
            "type": "string"
          },
          "start": {
            "format": "date-time",
            "title": "Start",
            "type": "string"
          },
          "title": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "start",
          "end",
          "title",
          "idempotency_key"
        ],
        "title": "hold_slotArguments",
        "type": "object"
      },
      "name": "hold_slot",
      "outputSchema": {
        "properties": {
          "end": {
            "format": "date-time",
            "title": "End",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "start": {
            "format": "date-time",
            "title": "Start",
            "type": "string"
          },
          "status": {
            "enum": [
              "busy",
              "tentative"
            ],
            "title": "Status",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "start",
          "end",
          "id",
          "title",
          "status"
        ],
        "title": "Event",
        "type": "object"
      }
    }
  }
}
