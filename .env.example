# Copy to .env and fill in. Never commit .env.
GROQ_API_KEY=
GIGBID_PROFILE=open

POSTGRES_USER=gigbid
POSTGRES_PASSWORD=
POSTGRES_DB=gigbid

OLLAMA_HOST=http://localhost:11434

# Marketplace MCP bearer tokens, JSON {"<token>": "<user id>"}. GigSim user ids: fr_ml, fr_fs, fr_da
MARKETPLACE_MCP_TOKENS=
GIGSIM_URL=http://localhost:8100
# In-process and stdio runs only; HTTP always uses the tokens above
MARKETPLACE_LOCAL_USER=fr_ml

# Portfolio MCP bearer tokens, JSON {"<token>": "<persona folder>"}; stdio uses PORTFOLIO_LOCAL_USER
PORTFOLIO_MCP_TOKENS=
PORTFOLIO_LOCAL_USER=fr_ml
