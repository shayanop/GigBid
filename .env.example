# Copy to .env and fill in. Never commit .env.
# NVIDIA NIM (build.nvidia.com): Writer and Critic in the `nim` profile, with Groq as their backup.
NIM_API_KEY=
# Groq: the backup when a NIM call fails or is rate-limited.
GROQ_API_KEY=
# Optional: several keys, comma-separated; on a 429 the next key is used. Groq limits are
# per organization, so keys only add quota when they come from different Groq accounts.
GROQ_API_KEYS=
GIGBID_PROFILE=open
# GitHub token for the portfolio builder (X3): fine-grained, read-only Contents on the
# portfolio repositories. Only sent to GitHub's MCP server.
GITHUB_TOKEN=

POSTGRES_USER=gigbid
POSTGRES_PASSWORD=
POSTGRES_DB=gigbid
DATABASE_URL=postgresql://gigbid:<password>@localhost:5432/gigbid
REDIS_URL=redis://localhost:6379/0
# Integration tests use a separate database and Redis db; they skip when unset.
TEST_DATABASE_URL=postgresql://gigbid:<password>@localhost:5432/gigbid_test
TEST_REDIS_URL=redis://localhost:6379/15

# Random strings, e.g. python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=
MCP_SIGNING_SECRET=

OLLAMA_HOST=http://localhost:11434
GIGSIM_URL=http://localhost:8100
MARKETPLACE_MCP_URL=http://localhost:8200/mcp
PORTFOLIO_MCP_URL=http://localhost:8300/mcp
WORKSPACE_MCP_URL=http://localhost:8400/mcp
# In-process and stdio MCP runs only; HTTP always uses signed tokens (MCP_SIGNING_SECRET)
MARKETPLACE_LOCAL_USER=fr_ml
PORTFOLIO_LOCAL_USER=fr_ml
WORKSPACE_LOCAL_USER=fr_ml

# Demo account created by `make seed`
DEMO_EMAIL=demo@gigbid.test
DEMO_PASSWORD=
